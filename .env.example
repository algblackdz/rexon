# ===== NEXORA — انسخ هذا الملف إلى .env وعدّل القيم =====
# لا تضع مفاتيح حقيقية داخل الكود أبدًا. ضعها هنا فقط.

# --- الخادم ---
PORT=3000
NODE_ENV=development
# رابط المنصة العام (يُستخدم في روابط الدفع واستعادة كلمة المرور)
APP_URL=http://localhost:3000
# نطاق المواقع المنشورة (username.nexora.app). اتركه فارغًا للعمل عبر /s/<subdomain>
PLATFORM_DOMAIN=
# سرّ توقيع الجلسات (إجباري في الإنتاج). مثال للتوليد: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- قاعدة البيانات ---
# الافتراضي: ملف JSON محلي. للإنتاج انتقل إلى PostgreSQL (انظر database/schema.sql و README)
DATABASE_URL=
DATA_FILE=./data/db.json

# --- الذكاء الاصطناعي ---
# بدون مفتاح: يعمل المولّد التجريبي (Mock). مع المفتاح: يستخدم Claude لتوليد Schema حقيقي.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- الدفع (Stripe) ---
# بدون مفاتيح: وضع دفع تجريبي. مع المفاتيح: Stripe Checkout حقيقي + Webhook موقّع.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEBSITE_PRICE_USD=5
TRIAL_DAYS=7

# --- Google Login (اختياري) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== إضافات النسخة الجديدة =====
# قاعدة بيانات الحسابات (منفصلة عن المواقع). على Render ضعها داخل القرص الدائم مثل /var/data/accounts.json
ACCOUNTS_FILE=
# مفتاح سري تدخله مرة واحدة من الإعدادات لتصبح "مؤسسًا" (founder). اختر نصًا طويلًا عشوائيًا.
FOUNDER_SETUP_KEY=a7ac4ab45f1ce3d50a5bcece
# بريد Gmail لاستعادة كلمة المرور وإرسال الفواتير (استخدم App Password وليس كلمة مرور حسابك)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NEXORA <your-gmail@gmail.com>

# ===== إعلانات (Ads Hub) =====
# بدل هذه المتغيرات يمكنك لصق القيم من داخل الموقع: لوحة التحكم ← الطاقم ← التكاملات والمفاتيح
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# أقصى ميزانية يومية يسمح بها الخادم للمستخدم (حماية له)
ADS_MAX_DAILY_BUDGET=500
